#!/bin/bash
# forwarder: ~/.aibos/bin/aibos, choose the AIBOS version and call it (spec 04)

   if [ "$*" == "---help" ]; then
      echo "   usage: aibos <args>      # forward <args> to aibos of the chosen version"
      echo "          aibos ---which    # show the chosen installation and why"
      echo "          aibos ---version  # print version of this forwarder"
      echo "          aibos ---help     # this help"
      echo '   order: AIBOS_HOME, aibos --activate v<version> (that version), aibos: in'
      echo '          .aibos/config.yaml of the vault root, else aios: 0.6.x in .aios/config.yaml'
      echo '          (Altbindung, its bin/aios), otherwise aibos --context: ai-brain with'
      echo '          legacy: ai-brain there, else nothing; everything else: highest installed'
      echo '          version; aibos --install distribution-*, aibos --remove-version and aibos --vaults:'
      echo '          always the highest installed version; a binding below 0.6 counts as none;'
      echo '          aibos --workspace <cmd> <path>: the binding of the vault at <path>;'
      echo '          the working directory is gone: the first absolute path, else a message;'
      echo '          until AIBOS 0.8 also AIOS_HOME, AIOS_PREFIX and the name aios'
      echo '   see also: aibos, ai-brain'
      exit 1
   fi

#===============================================================================
# print version: aibos ---version
#===============================================================================

   if [ "$*" == "---version" ]; then
      echo "0.5.0"; exit 0
   fi

#===============================================================================
# helpers: installations, versions, activation
#===============================================================================

   AIBOS_HOME="${AIBOS_HOME:-$AIOS_HOME}"           # AIOS_<x> until AIBOS 0.8 (spec 04, F268)
   PREFIX="${AIBOS_PREFIX:-${AIOS_PREFIX:-/opt/aibos}}"

   installed() {                                    # print "v<version>|<path>", user wins
      local F LINE NAME VAL SEEN=""
      for F in "$HOME/.aibos/installations.yaml" "$PREFIX/installations.yaml"; do
         [ -f "$F" ] || continue
         while IFS= read -r LINE || [ -n "$LINE" ]; do
            LINE="${LINE%$'\r'}"
            [[ "$LINE" =~ ^(v[0-9][^:[:space:]]*):[[:space:]]*(.*)$ ]] || continue
            NAME="${BASH_REMATCH[1]}"; VAL="${BASH_REMATCH[2]}"
            VAL="${VAL%%[[:space:]]#*}"; VAL="${VAL%"${VAL##*[![:space:]]}"}"
            VAL="${VAL#\"}"; VAL="${VAL%\"}"; VAL="${VAL#\'}"; VAL="${VAL%\'}"
            case "$VAL" in "~") VAL="$HOME";; "~/"*) VAL="$HOME/${VAL#\~/}";; esac
            case " $SEEN " in *" $NAME "*) continue;; esac
            SEEN="$SEEN $NAME"
            echo "$NAME|$VAL"
         done < "$F"
      done
   }

   lookup() {                                       # path of v<version> or nothing
      local E
      while IFS= read -r E; do
         [ "${E%%|*}" == "v$1" ] && { echo "${E#*|}"; return 0; }
      done < <(installed)
      return 1
   }

   newer() {                                        # semver: is $1 newer than $2 ?
      local A="${1#v}" B="${2#v}" AP="" BP="" I X Y
      [[ "$A" == *-* ]] && { AP="${A#*-}"; A="${A%%-*}"; }
      [[ "$B" == *-* ]] && { BP="${B#*-}"; B="${B%%-*}"; }
      IFS=. read -r -a X <<< "$A"; IFS=. read -r -a Y <<< "$B"
      for I in 0 1 2; do
         [ "$((10#${X[$I]:-0}))" -gt "$((10#${Y[$I]:-0}))" ] && return 0
         [ "$((10#${X[$I]:-0}))" -lt "$((10#${Y[$I]:-0}))" ] && return 1
      done
      [ -z "$AP" ] && [ -n "$BP" ] && return 0      # release beats pre-release
      [ -n "$AP" ] && [ -z "$BP" ] && return 1
      [[ "$AP" > "$BP" ]]
   }

   highest() {                                      # print "v<version>|<path>"
      local E BEST=""
      while IFS= read -r E; do
         { [ -z "$BEST" ] || newer "${E%%|*}" "${BEST%%|*}"; } && BEST="$E"
      done < <(installed)
      [ -n "$BEST" ] && echo "$BEST"
   }

   vault_root() {                                   # nearest dir named §* above the physical cwd
      local D; D="$(pwd -P)"
      while :; do
         case "$(basename "$D")" in §*) echo "$D"; return 0;; esac
         [ "$D" == "/" ] && return 1
         D="$(dirname "$D")"
      done
   }

   config() {                                       # config.yaml of the vault root: .aibos/, else .aios/ (F270)
      local ROOT
      ROOT="$(vault_root)" || return 1              # outside a vault: never activated
      [ "$ROOT" != "$(cd "$HOME" 2>/dev/null && pwd -P)" ] || return 1
      if [ -f "$ROOT/.aibos/config.yaml" ]; then echo "$ROOT/.aibos/config.yaml"; return 0; fi
      if [ -f "$ROOT/.aios/config.yaml" ]; then echo "$ROOT/.aios/config.yaml"; return 0; fi
      return 1
   }

   activation() {                                   # print "<version>|<config>" or nothing
      local LINE F KEY V                            # only the vault root binds (spec 04, I14)
      F="$(config)" || return 1
      case "$F" in */.aios/config.yaml) KEY=aios;; *) KEY=aibos;; esac
      LINE="$(grep -E -m1 "^$KEY:" "$F")"
      if [[ "$LINE" =~ ^[a-z]+:[[:space:]]*[\"\']?v?([0-9][^\"\'[:space:]#]*) ]]; then
         V="${BASH_REMATCH[1]}"
         [ "$KEY" == aios ] && [[ "$V" =~ ^0\.[0-5](\.|$) ]] && return 1   # aios: below 0.6: none (FL9)
         echo "$V|$F"; return 0
      fi
      return 1
   }

   marked() {                                       # legacy: ai-brain at the vault root (spec 02)
      local F
      F="$(config)" || return 1
      grep -Eq '^legacy:[[:space:]]*["'"'"']?ai-brain["'"'"']?[[:space:]]*(#.*)?$' "$F"
   }

   program() {                                      # bin/aibos of an installation, bin/aios of 0.6.x (FL6, FL11)
      if [ -x "$1/bin/aibos" ] || [ ! -x "$1/bin/aios" ]; then echo "$1/bin/aibos"; else echo "$1/bin/aios"; fi
   }

   log() {                                          # errors outside an A/W only into the log (spec 02)
      mkdir -p "$HOME/.aibos/log" 2>/dev/null && \
         echo "$(date '+%Y-%m-%dT%H:%M:%S') forwarder cwd=$(pwd -P 2>/dev/null || echo "$PWD") $*" >> "$HOME/.aibos/log/context.log"
   }

   choose() {                                       # set KIND, TARGET, WHY (ARG1, ARG2: the first arguments)
      local A E
      KIND=""; TARGET=""; WHY=""
      if [ -n "$AIBOS_HOME" ]; then
         KIND=aibos; TARGET="$AIBOS_HOME/bin/aibos"; WHY="AIBOS_HOME=$AIBOS_HOME"; return 0
      fi
      if [[ "$ARG1" == "--install" && "$ARG2" =~ ^([A-Za-z0-9._-]+/)?distribution- ]] \
            || [ "$ARG1" == "--remove-version" ] || [ "$ARG1" == "--vaults" ]; then
         if E="$(highest)"; then                    # independent of cwd: the newest kernel knows all vaults (V0.6, B21)
            KIND=aibos; TARGET="$(program "${E#*|}")"; WHY="aibos $ARG1: highest installed ${E%%|*}"; return 0
         fi
      fi
      if [ "$ARG1" == "--activate" ] && [[ "$ARG2" =~ ^v([0-9][^[:space:]]*)$ ]] \
            && E="$(lookup "${BASH_REMATCH[1]}")"; then
         KIND=aibos; TARGET="$(program "$E")"; WHY="aibos --activate $ARG2"; return 0   # V0.3, memo 54 (A1)
      fi
      if A="$(activation)"; then
         case "${A#*|}" in */.aios/config.yaml) WHY="aios: ${A%%|*} in ${A#*|}";; *) WHY="aibos: ${A%%|*} in ${A#*|}";; esac
         if E="$(lookup "${A%%|*}")"; then
            KIND=aibos; TARGET="$(program "$E")"; return 0
         fi
         KIND=missing; TARGET="v${A%%|*}"; return 0
      fi
      if [ "$ARG1" == "--context" ]; then           # only the group --context calls ai-brain (V0.5, memo 03)
         if marked; then
            KIND=legacy; TARGET="$(command -v ai-brain)"; WHY="legacy: ai-brain at the vault root"
         else
            KIND=quiet; WHY="no binding: vault without aibos: or outside a vault"
         fi
         return 0
      fi
      if E="$(highest)"; then
         KIND=aibos; TARGET="$(program "${E#*|}")"; WHY="not activated, highest installed ${E%%|*}"
         return 0
      fi
      KIND=none; WHY="no installation of AIBOS found"
   }

   ARG1="$1"; ARG2="$2"

#===============================================================================
# the working directory is gone: the first absolute path, else a message (V0.6, memo 204: H34)
#===============================================================================

   if ! pwd -P >/dev/null 2>&1 || [ ! -d "$PWD" ]; then
      ABS=""
      for A in "$@"; do
         case "$A" in
            /*) if [ -d "$A" ]; then ABS="$A"; elif [ -d "$(dirname "$A")" ]; then ABS="$(dirname "$A")"; fi ;;
         esac
         [ -n "$ABS" ] && break
      done
      if [ -n "$ABS" ]; then
         cd "$ABS" 2>/dev/null || exit 1
      elif [ "$1" == "--context" ]; then          # hooks: never output, only the log (spec 02)
         log "the current directory no longer exists"
         [ "$2" == "--id" ] && echo "id=- files=0 cwd=$PWD mode=none"
         exit 0
      else
         echo "*** aibos: the current directory no longer exists; change to an existing one (e.g. cd ~) or give an absolute path" >&2
         exit 1
      fi
   fi

#===============================================================================
# aibos --context [--load|--id|--list] <path>: the version follows <path>
#===============================================================================

   if [ "$1" == "--context" ]; then
      P=""
      if [ -d "$2" ] && [ "$3" == "" ]; then P="$2"
      elif [ -d "$3" ] && [ "$4" == "" ]; then
         case "$2" in --load|--id|--list) P="$3";; esac
      fi
      if [ -n "$P" ]; then
         cd "$P" || exit 1
         choose; case "$KIND" in legacy|quiet) [ "$P" == "$2" ] && set -- --context || set -- --context "$2";; esac
      fi
   fi

#===============================================================================
# show choice: aibos ---which
#===============================================================================

   if [ "$*" == "---which" ]; then
      choose
      echo "tool=aibos kind=$KIND target=${TARGET:--} why=$WHY"
      exit 0
   fi

#===============================================================================
# forward: aibos <args>
#===============================================================================

   WSDIR=""                                         # --workspace <cmd> <path>: the binding at <path>
   if [ "$1" == "--workspace" ]; then              # (V0.6, memo 208: H37)
      SKIP=""
      for A in "${@:3}"; do
         if [ -n "$SKIP" ]; then SKIP=""; continue; fi
         case "$A" in --group|--at|--accept-deletion) SKIP=1; continue;; -*) continue;; esac
         if [ -d "$A" ]; then WSDIR="$A"; elif [ -d "$(dirname "$A")" ]; then WSDIR="$(dirname "$A")"; fi
         break
      done
   fi
   if [ -n "$WSDIR" ]; then
      OLD="$(pwd -P 2>/dev/null)"
      if cd "$WSDIR" 2>/dev/null; then
         choose; [ -n "$OLD" ] && cd "$OLD" 2>/dev/null
      else
         choose
      fi
   else
      choose
   fi
   case "$KIND" in
      aibos)
         [ -x "$TARGET" ] || { echo "*** aibos: $TARGET not found ($WHY)" >&2; exit 1; }
         exec "$TARGET" "$@"
         ;;
      quiet)                                        # outside an A/W: nothing (spec 02, I12)
         [ "$2" == "--id" ] && echo "id=- files=0 cwd=$PWD mode=none"
         [ "$2" == "--list" ] && echo "No AIBOS workspace — no master context."
         exit 0
         ;;
      legacy)
         shift                                      # ai-brain takes the arguments after --context
         [ "$*" == "" ] && set -- --context         # aibos --context = master context
         [ "$*" == "--permit" ] && exit 0           # no permission from ai-brain (spec 02)
         if [ "$*" == "--list" ]; then              # spec 02: listing of /aibos-context
            echo "Legacy mode (ai-brain, legacy: ai-brain at the vault root) — see /masterspace."
            exit 0
         fi
         if [ "$*" == "--id" ]; then                # spec 02: --id names the mode
            OUT=""; [ -n "$TARGET" ] && OUT="$("$TARGET" --id 2>/dev/null)"
            case "$OUT" in
               id=*) echo "$OUT mode=legacy" ;;
               *)    echo "id=- files=0 cwd=$PWD mode=legacy" ;;
            esac
            exit 0
         fi
         [ -n "$TARGET" ] || exit 0                 # no ai-brain: no output
         exec "$TARGET" "$@"
         ;;
      missing)
         if [ "$1" == "--context" ]; then           # hooks: never output, only the log (spec 04)
            log "AIBOS $TARGET is not installed ($WHY)"
            [ "$2" == "--id" ] && echo "id=- files=0 cwd=$PWD mode=none"
            exit 0
         fi
         echo "*** aibos: AIBOS $TARGET is not installed ($WHY)" >&2
         echo "    run: aibos --install $TARGET" >&2
         exit 1
         ;;
   esac

#===============================================================================
# cannot deal with anything else ...
#===============================================================================

   echo "*** aibos: $WHY" >&2
   echo "    run: ./bin/aibos --install in a clone of aibex-aibos" >&2
   exit 1
